# RulePulse — Autonomous, Read-Only Detection Quality & SIEM Drift Assurance Agent
# Optional Gemini API key for bounded second-opinion adjudication on borderline Z-scores (2.2 <= |Z| < 3.5).
# Leave unset to run 100% deterministically (borderline items degrade safely to 'needs_review').
GEMINI_API_KEY=
RULEPULSE_MAX_LLM_CALLS_PER_RUN=5
RULEPULSE_DAILY_TERABYTE_QUOTA=2.50
RULEPULSE_STATE_DIR=.state
